{
  "name": "strelit-ui-kit",
  "version": "0.1.0",
  "description": "Strelit UI layout workspace toolkit",
  "keywords": [
    "docking",
    "layout",
    "typescript",
    "workspace",
    "ui"
  ],
  "license": "MIT",
  "author": "CTHub",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.mjs",
  "typings": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.js"
    },
    "./dist/css/*": "./dist/css/*",
    "./dist/less/*": "./dist/less/*",
    "./dist/scss/*": "./dist/scss/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*"
  ],
  "sideEffects": [
    "dist/**/*.css",
    "dist/**/*.less",
    "dist/**/*.scss"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "scripts": {
    "clean": "rimraf dist lib temp apitest/dist",
    "typecheck:cjs": "tsc -p tsconfig.cjs.json --noEmit",
    "typecheck:module:api": "tsc -p tsconfig.module.api.json --noEmit",
    "typecheck:apitest": "tsc -p apitest/tsconfig.json --noEmit",
    "typecheck": "npm run typecheck:cjs && npm run typecheck:module:api && npm run typecheck:apitest",
    "build:cjs": "tsup src/index.ts --format cjs --outDir dist/cjs --target es2020 --sourcemap --external tslib --clean false --splitting false",
    "build:module": "tsup src/index.ts --format esm --outDir dist/esm --target es2020 --sourcemap --external tslib --clean false --splitting false",
    "build:module:api": "tsc -p tsconfig.module.api.json",
    "build:module:full": "tsc -p tsconfig.module.full.json",
    "build:module:strip": "tsc -p tsconfig.module.strip.json",
    "build:js": "tsup --config tsup.config.ts",
    "build:types": "tsc -p tsconfig.types.json",
    "build:styles": "node ./scripts/css.js",
    "build": "npm run clean && npm run build:js && npm run build:types && npm run build:styles && api-extractor run --local --verbose",
    "lint": "oxlint --type-aware --deny-warnings --ignore-path .gitignore . && npm run lint:docs",
    "lint:fix": "oxlint --type-aware --fix --ignore-path .gitignore .",
    "lint:docs": "typedoc --options ./typedoc.stripInternal.json --emit none",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run test/bench",
    "bench:watch": "vitest bench test/bench",
    "coverage": "vitest run --coverage",
    "doc": "npm run build && typedoc --options ./typedoc.stripInternal.json",
    "doc:typedoc:full": "rimraf .generated-docs/full && typedoc --options ./typedoc.full.json",
    "doc:typedoc:strip": "rimraf .generated-docs/strip && typedoc --options ./typedoc.stripInternal.json",
    "verify:ordered": "node ./scripts/verify-ordered.js",
    "apitest:build": "vite build --config ./vite.apitest.config.ts",
    "apitest:serve": "vite --config ./vite.apitest.config.ts",
    "apitest:smoke": "node ./scripts/smoke-apitest.js",
    "migrate:golden-layout": "node ./scripts/migrate-golden-layout-to-strelit.js",
    "audit:compatibility": "node ./scripts/audit-compatibility.js --validate",
    "audit:compatibility:check": "node ./scripts/audit-compatibility.js --check",
    "audit:compatibility:refresh": "node ./scripts/audit-compatibility.js --write",
    "sonar": "npx sonarqube-scanner",
    "sonar:coverage": "npm run coverage && npm run sonar",
    "sonar:issues": "node ./scripts/sonar-report.js"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.1",
    "@vitest/coverage-v8": "^4.0.7",
    "autoprefixer": "^10.4.21",
    "jsdom": "^27.0.1",
    "less": "^4.4.2",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.0",
    "sonarqube-scanner": "^4.4.0",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "vitest": "^4.0.7"
  },
  "browserslist": [
    "last 1 Chrome version",
    "last 1 Firefox version",
    "last 2 Edge major versions",
    "last 2 Safari major versions",
    "last 2 iOS major versions",
    "Firefox ESR"
  ]
}
